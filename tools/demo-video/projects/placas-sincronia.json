 "code": "// Duas placas, um sketch: varredura em sincronia\n// TX do Uno A -> RX do Uno B; o mesmo firmware roda nas duas\nvoid loop() {\n  digitalWrite(13, HIGH); delay(140);\n  digitalWrite(13, LOW);  delay(0);\n  digitalWrite(12, HIGH); delay(140);\n  digitalWrite(12, LOW);  delay(0);\n  digitalWrite(11, HIGH); delay(140);\n  digitalWrite(11, LOW);  delay(0);\n  digitalWrite(10, HIGH); delay(140);\n  digitalWrite(10, LOW);  delay(0);\n  digitalWrite(11, HIGH); delay(140);\n  digitalWrite(11, LOW);  delay(0);\n  digitalWrite(12, HIGH); delay(140);\n  digitalWrite(12, LOW);  delay(0);\n}"
