 "code": "// Semáforo com travessia sonora\n// D13/D12/D11 = carros · D9/D10 = pedestres · D8 = bipe\nvoid setup() {\n  for (int p = 8; p <= 13; p++) pinMode(p, OUTPUT);\n}\n\nvoid loop() {\n  digitalWrite(9, HIGH);  delay(100);   // pedestre: pare\n  digitalWrite(11, HIGH); delay(1600);  // carros: verde\n  digitalWrite(11, LOW);  delay(0);\n  digitalWrite(12, HIGH); delay(900);   // carros: amarelo\n  digitalWrite(12, LOW);  delay(0);\n  digitalWrite(13, HIGH); delay(250);   // carros: vermelho\n  digitalWrite(9, LOW);   delay(0);\n  digitalWrite(10, HIGH); delay(200);   // pedestre: siga\n  digitalWrite(8, HIGH);  delay(180);   // bipe, bipe, bipe\n  digitalWrite(8, LOW);   delay(180);\n  digitalWrite(8, HIGH);  delay(180);\n  digitalWrite(8, LOW);   delay(180);\n  digitalWrite(8, HIGH);  delay(180);\n  digitalWrite(8, LOW);   delay(400);\n  digitalWrite(10, LOW);  delay(0);\n  digitalWrite(13, LOW);  delay(0);\n}"
